            <EntryEntity>
              <Rules>
                <BizRule>
                  <PreDescription>报价金额按数量、单价、折扣率自动计算</PreDescription>
                  <TriggerField>数量(bnuy_qty);单价(bnuy_unit_price);折扣率(bnuy_discount_rate)</TriggerField>
                  <TrueActions>
                    <FormulaAction>
                      <RET>253</RET>
                      <ActionType>FormulaAction</ActionType>
                      <Expression>bnuy_quote_amount = bnuy_qty * bnuy_unit_price * bnuy_discount_rate</Expression>
                      <Description>报价金额 = 数量 × 单价 × 折扣率</Description>
                      <Id>64L8/0VBT2UD</Id>
                      <Seq>1</Seq>
                    </FormulaAction>
                  </TrueActions>
                  <Description>报价金额 = 数量 × 单价 × 折扣率</Description>
                  <Id>64L8/0V95NZM</Id>
                  <PreCondition>1=1</PreCondition>
                  <Seq>1</Seq>
                </BizRule>
              </Rules>
